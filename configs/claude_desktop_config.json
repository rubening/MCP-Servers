{
  "mcpServers": {
    "filesystem": {
      "command": "py",
      "args": ["${REPO_ROOT}\\servers\\python\\filesystem\\filesystem.py"]
    },
    "execute-command": {
      "command": "py",
      "args": ["${REPO_ROOT}\\servers\\python\\execute-command\\execute_command.py"]
    },
    "git": {
      "command": "py",
      "args": ["${REPO_ROOT}\\servers\\python\\git\\git.py"]
    },
    "youtube": {
      "command": "py",
      "args": ["${REPO_ROOT}\\servers\\python\\youtube\\youtube_enhanced.py"]
    },
    "project-instructions-generator": {
      "command": "py",
      "args": ["${REPO_ROOT}\\servers\\python\\project-instructions-generator\\project_instructions_generator.py"]
    },
    "personal-knowledge-intelligence": {
      "command": "py",
      "args": [
        "${REPO_ROOT}\\servers\\python\\personal-knowledge-intelligence\\personal_knowledge_intelligence_fixed.py",
        "--db-path",
        "${DATA_ROOT}\\personal_intelligence.db"
      ]
    },
    "analytics": {
      "command": "py",
      "args": [
        "${REPO_ROOT}\\servers\\python\\analytics\\duckdb_analytics_fixed.py",
        "--db-path",
        "${DATA_ROOT}\\business_intelligence.db"
      ]
    },
    "github": {
      "command": "docker",
      "args": ["run", "--rm", "-i", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN=${GITHUB_PERSONAL_ACCESS_TOKEN}", "ghcr.io/github/github-mcp-server"]
    },
    "playwright": {
      "command": "docker",
      "args": ["run", "--rm", "-i", "--cap-add=SYS_ADMIN", "mcr.microsoft.com/playwright/mcp"]
    },
    "sequentialthinking": {
      "command": "docker",
      "args": ["run", "--rm", "-i", "mcp/sequentialthinking"]
    },
    "deepseek": {
      "command": "py",
      "args": ["${REPO_ROOT}\\servers\\python\\deepseek\\deepseek_protocol_fixed.py"],
      "env": {
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
        "DEEPSEEK_API_KEY": "${DEEPSEEK_API_KEY}"
      }
    },
    "clickup": {
      "command": "npx",
      "args": ["-y", "@taazkareem/clickup-mcp-server@latest"],
      "env": {
        "CLICKUP_API_KEY": "${CLICKUP_API_KEY}",
        "CLICKUP_TEAM_ID": "${CLICKUP_TEAM_ID}",
        "DOCUMENT_SUPPORT": "true"
      }
    },
    "chroma-secure": {
      "command": "py",
      "args": [
        "${REPO_ROOT}\\servers\\python\\chroma-secure\\chroma_secure_fixed.py",
        "--data-dir",
        "${SECURE_DATA_ROOT}\\chroma_law_firm"
      ]
    },
    "gdrive": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-gdrive"],
      "env": {
        "GDRIVE_CREDENTIALS_PATH": "${SECURE_CONFIG_ROOT}\\gdrive-credentials.json"
      }
    },
    "web-search": {
      "command": "node",
      "args": ["${REPO_ROOT}\\servers\\node\\web-search\\index.js"],
      "cwd": "${REPO_ROOT}\\servers\\node\\web-search"
    }
  }
}
